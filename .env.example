# Copy to .env.local and fill in with your Google OAuth client ID.
# Create one at https://console.cloud.google.com/apis/credentials (OAuth client ID -> Web application).
# Add your dev origin (e.g. http://localhost:5173) to the authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Point the app at the real backend. Leave empty to use the bundled MSW mock API.
# Example for the local server/ package: http://localhost:4000/api/v1
VITE_API_BASE_URL=
