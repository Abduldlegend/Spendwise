NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB Atlas connection string.
# Atlas -> your cluster -> Connect -> Drivers -> Node.js.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendwise?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/spendwise?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change_me_long_random_access_secret
JWT_REFRESH_SECRET=change_me_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
